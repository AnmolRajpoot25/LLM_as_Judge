# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=sqlite:///./llm_judge.db

# Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Timeouts & Limits
GENERATION_TIMEOUT_SECONDS=60
JUDGE_TIMEOUT_SECONDS=90
MAX_SELECTED_MODELS=4

# Optional Judge Configuration
DEFAULT_JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct
POSITION_SWAP_CHECK=false

# Remote Hugging Face Qwen Judge (Space or Inference API on Free Tier)
QWEN_HF_API_URL=https://<your-space-name>.hf.space
QWEN_HF_TOKEN=

# Authentication & Security
AUTH_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ENCRYPTION_SECRET_KEY=change-this-to-a-secure-key-for-encrypting-user-api-keys
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

